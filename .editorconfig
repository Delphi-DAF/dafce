# Editor configuration, see http://editorconfig.org
#
# Este fichero obliga a los EDITORES y a nadie más. Un fichero escrito por un
# script o por un agente —que no abre editor— no lo consulta, y cada vez se
# escribe más repo por esa vía. La red de seguridad real es .gitattributes, que
# declara lo mismo y git sí aplica al indexar. Auditar con:
#
#   git ls-files --eol | awk '($2=="w/lf" && /eol=crlf/) || ($2=="w/crlf" && /eol=lf/)'
#
# Las dos ediciones comparten este fichero: mantenerlo igual en DAFce y DAFpro.

root = true

# Fuentes Delphi. utf-8-bom, NO utf-8: el IDE de Rad Studio exige el BOM
# siempre, no solo cuando el fichero tiene caracteres no ASCII. Sin BOM el
# fichero se lee como ANSI y cualquier no-ASCII se corrompe en silencio, sin
# que el compilador diga nada — por eso hay una auditoría de BOM en las notas.
[*.{pas,dpr,dpk,inc}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 2
max_line_length = 132
insert_final_newline = true
trim_trailing_whitespace = true

# Ficheros de proyecto. Los escribe el IDE, así que aquí solo se declara lo que
# no debe cambiar; ni se recorta ni se reindenta. Son merge=binary en
# .gitattributes, de modo que un cambio de solo espacios no es ruido: es un
# conflicto que no se puede fusionar.
[*.{dproj,groupproj,optset,dfm}]
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = false
trim_trailing_whitespace = false

# Markdown y Quarto van juntos: .qmd es el mismo material, solo que renderizado.
# Sin recorte de espacios finales — en Markdown dos al final son un salto de línea.
[*.{md,qmd}]
charset = utf-8
end_of_line = crlf
max_line_length = off
trim_trailing_whitespace = false

[*.{js,ini}]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 2
max_line_length = 132
insert_final_newline = true
trim_trailing_whitespace = true

# Scripts de Windows: los consume cmd.exe en la VM.
[*.{bat,cmd}]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

# Herramientas y configuración, en convención de su propio ecosistema.
[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
