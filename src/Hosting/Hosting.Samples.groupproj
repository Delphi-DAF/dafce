<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{71660C4D-B2C8-45F2-9D3F-22CBB0D1FEF3}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="samples\HostQuickStart\HostQuickStart.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="samples\StartupReport\StartupReport.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="samples\HostLifetime\HostLifetime.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="HostQuickStart">
        <MSBuild Projects="samples\HostQuickStart\HostQuickStart.dproj"/>
    </Target>
    <Target Name="HostQuickStart:Clean">
        <MSBuild Projects="samples\HostQuickStart\HostQuickStart.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HostQuickStart:Make">
        <MSBuild Projects="samples\HostQuickStart\HostQuickStart.dproj" Targets="Make"/>
    </Target>
    <Target Name="StartupReport">
        <MSBuild Projects="samples\StartupReport\StartupReport.dproj"/>
    </Target>
    <Target Name="StartupReport:Clean">
        <MSBuild Projects="samples\StartupReport\StartupReport.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StartupReport:Make">
        <MSBuild Projects="samples\StartupReport\StartupReport.dproj" Targets="Make"/>
    </Target>
    <Target Name="HostLifetime">
        <MSBuild Projects="samples\HostLifetime\HostLifetime.dproj"/>
    </Target>
    <Target Name="HostLifetime:Clean">
        <MSBuild Projects="samples\HostLifetime\HostLifetime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HostLifetime:Make">
        <MSBuild Projects="samples\HostLifetime\HostLifetime.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="HostQuickStart;StartupReport;HostLifetime"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="HostQuickStart:Clean;StartupReport:Clean;HostLifetime:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="HostQuickStart:Make;StartupReport:Make;HostLifetime:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
