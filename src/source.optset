<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildThisFileDirectory)paths.optset"/>
    <PropertyGroup>
        <DCC_DcpOutput>$(DAF_FW_LIB)</DCC_DcpOutput>
        <DCC_ExeOutput>$(DAF_FW_BIN)</DCC_ExeOutput>
        <DCC_BplOutput>$(DAF_FW_BIN)</DCC_BplOutput>
        <DCC_DcuOutput>$(DAF_FW_LIB)</DCC_DcuOutput>
        <DCC_UnitSearchPath>$(BDS)\Lib\$(Config)\Indy10;$(BDS)\lib;$(VENDOR_LIB);$(DAF_FW_LIB);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_MapFile>0</DCC_MapFile>
    </PropertyGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>OptionSet</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality/>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <PropertyGroup>
        <PostBuildEvent>if exist "$(MSBuildProjectDirectory)\*.dfm" copy /Y "$(MSBuildProjectDirectory)\*.dfm" "$(DAF_FW_LIB)\" &gt;nul</PostBuildEvent>
    </PropertyGroup>
</Project>
