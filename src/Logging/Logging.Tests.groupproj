    </Target>
    <Target Name="Clean">
        <CallTarget Targets="LoggingSpecs:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="LoggingSpecs:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
