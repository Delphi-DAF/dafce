package Daf.Web;
{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  // Web.HTTPApp and Web.WebReq: WebBroker's request, response and dispatcher.
  inet,
  // Web.Stencils, which Daf.Web.Render is built on. It is what brings the
  // System.Bindings units with it — the cost of server-side rendering, not
  // residue.
  inetstn,
  // The HTTP server itself and the socket handle the port check binds.
  IndySystem,
  IndyCore,
  IndyProtocols,
  // REST.Json, which turns an action's object into the response body.
  RESTComponents,
  Daf.DependencyInjection.Abstractions,
  Daf.Configuration.Abstractions,
  Daf.Logging.Abstractions,
  // La variante Web de la familia vive aqui, con la maquinaria comun del arranque y el
  // manager que siembra antes de entregarlo.
  Daf.Hosting.Abstractions,
  Daf.Hosting,
  Daf.Configuration,
  // Llegaba de rebote por Daf.Hosting. Declarado, porque de rebote deja de llegar el dia que
  // esa ruta cambie -- y entonces el fallo no se parece a su causa.
  Daf.Commons;

contains
  Daf.Extensions.HttpServer in 'Daf.Extensions.HttpServer.pas',
  Daf.HttpServer in 'Daf.HttpServer.pas',
  Daf.Web.Router in 'Daf.Web.Router.pas',
  Daf.Web.Controller in 'Daf.Web.Controller.pas' {WebController: TDataModule},
  Daf.Web.Render in 'Daf.Web.Render.pas',
  Daf.Web.ActionResult in 'Daf.Web.ActionResult.pas',
  Daf.Web.Application in 'Daf.Web.Application.pas';

end.
