<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildThisFileDirectory)paths.optset"/>
    <PropertyGroup>
        <DAF_TEST_LIB>$(DAF_OUT)\test\$(MSBuildProjectName)\lib</DAF_TEST_LIB>
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
        <AppEnableRuntimeThemes>true</AppEnableRuntimeThemes>
        <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
        <DCC_DcpOutput>$(DAF_TEST_LIB)</DCC_DcpOutput>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <DCC_ExeOutput>$(DAF_OUT)\test\bin</DCC_ExeOutput>
        <DCC_BplOutput>$(DAF_TEST_LIB)</DCC_BplOutput>
        <DCC_DcuOutput>$(DAF_TEST_LIB)</DCC_DcuOutput>
        <DCC_UnitSearchPath>$(DAF_TEST_LIB);$(DAF_FW_LIB_DEBUG);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>OptionSet</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality/>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
</Project>
