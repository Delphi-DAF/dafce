package Daf.Application;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  // Por TVersionInfo, que se mudo aqui: es un record de 196 lineas que solo usa
  // System.SysUtils, y con TDafApplication deprecado no tiene por que vivir en su paquete.
  Daf.Commons,
  Daf.Configuration.Abstractions,
  Daf.DependencyInjection.Abstractions,
  Daf.DependencyInjection,
  Daf.Hosting.Abstractions,
  Daf.Hosting;

contains
  Daf.Application.Builder in 'Daf.Application.Builder.pas';

end.



